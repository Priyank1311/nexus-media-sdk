{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "lib": [
      "dom",
      "es2015",
      "es2017",
      "es2018",
      "es2019",
      "es2020",
      "es2021",
      "es2022"
    ]
  },
  "include": [
    "packages/media-core/src/**/*.ts",
    "packages/media-core/src/**/*.tsx",
    "packages/media-react/src/**/*.ts",
    "packages/media-react/src/**/*.tsx",
    "packages/media-native/src/**/*.ts",
    "packages/media-native/src/**/*.tsx",
    "packages/media-ui-react/src/**/*.ts",
    "packages/media-ui-react/src/**/*.tsx",
    "packages/media-ui-native/src/**/*.ts",
    "packages/media-ui-native/src/**/*.tsx"
  ]
}
